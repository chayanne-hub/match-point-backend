// Match Point — Database Schema
// Run: npx prisma migrate dev --name init
// Requires DATABASE_URL in .env (Postgres recommended)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Accounts & billing
// ---------------------------------------------------------------------------

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  username     String?   @unique // shown publicly instead of email — avoids doxxing streamers/on-screen viewers
  avatarUrl    String?   // Cloudinary URL, set via POST /auth/avatar
  passwordHash String
  createdAt    DateTime  @default(now())
  isAdmin      Boolean   @default(false)
  // Whop's user id (user_xxx), captured the first time a purchase of theirs
  // is seen. Lets later webhooks resolve to this account even when the
  // checkout metadata is missing and the emails don't match.
  whopUserId   String?   @unique

  subscription Subscription?
  purchases    PurchasedPick[]
}

// One active plan per user at a time. Single-pick buys don't create a row here —
// they go straight into PurchasedPick. This table is for Daily/Weekly Bundle and
// Monthly/Season Membership plans. Coinbase Commerce has no native subscription
// concept — "active" here just means the most recent renewal charge was paid
// and currentPeriodEnd hasn't passed yet. Renewal is a fresh charge each period
// (see the renewal-reminder scheduler), not automatic billing.
model Subscription {
  id                String   @id @default(uuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id])
  // Kept nullable for the legacy Coinbase Commerce rows — those still carry
  // a charge code, new Whop-backed rows never will.
  lastChargeCode    String?  @unique // legacy: Coinbase Commerce charge code
  // Whop membership id (mem_xxx). This is the source of truth for access
  // now: Whop owns billing and renewal, and tells us via webhook when a
  // membership goes valid or invalid.
  whopMembershipId  String?  @unique
  whopPlanId        String?
  plan              String   // plan key, e.g. "monthly_membership"
  status             String   // "active" | "past_due" | "canceled" | "incomplete"
  // With Whop this mirrors the membership's renewal_period_end. Unlike the
  // Coinbase flow (one-off charges granting a fixed window), renewal is
  // genuinely automatic, so this gets refreshed on each payment webhook.
  currentPeriodEnd   DateTime
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}
// A single-pick purchase, or a record of a pick a subscriber is entitled to view.
model PurchasedPick {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  pickId     String
  pick       Pick     @relation(fields: [pickId], references: [id])
  pricePaid  Int      // cents
  purchasedAt DateTime @default(now())

  @@unique([userId, pickId])
}

// ---------------------------------------------------------------------------
// Sports data
// ---------------------------------------------------------------------------

model Sport {
  id      String  @id @default(uuid())
  slug    String  @unique // "tennis" | "basketball" | "soccer" | "baseball" | "football"
  name    String
  matches Match[]
}

model Match {
  id           String   @id @default(uuid())
  sportId      String
  sport        Sport    @relation(fields: [sportId], references: [id])
  externalId   String   @unique // ID from the odds/data provider, for de-duping on each pull
  league       String   // "ATP" | "NBA" | "EPL" | "MLB" | "NFL" etc.
  skipAnalysis Boolean  @default(false) // true = pipeline never attempts this match again, e.g. bulk-skipped backlog after a balance-outage window
  analysisFailCycles Int @default(0) // how many separate 15-min cycles this match has FULLY failed (both first attempt and retry exhausted) — real fix for a confirmed bug: previously a stubborn match could be re-attempted every single cycle for hours with no cap, each cycle burning a full paid attempt+retry for zero output
  competitorA  String
  competitorB  String
  startTime    DateTime
  status       String   // "scheduled" | "live" | "final" | "postponed"
  surface      String?  // tennis only
  venue        String?
  liveScore    String?  // free-text live score snapshot, updated by the live poller
  liveClock    String?  // "Q3 8:42", "62'", "Top 6th", "Set 2", etc. — display only
  period       Int?     // structured period/quarter number, for formulas that need real math on it
  clockSeconds Int?     // seconds remaining in the current period — same reasoning
  homeScore    Int?     // structured final/current score for competitorA — needed to
  awayScore    Int?     // compute recent-form factors once matches complete
  setScore     String?  // tennis only — set-by-set games score, e.g. "6-4, 3-2"
  periodScores String?  // basketball/football — quarter-by-quarter score, e.g. "25-28, 20-21, 20-24, 22-25"
  // Best price across every US book, captured alongside the BetMGM line of
  // record. Display only — grading and the published track record stay on
  // BetMGM so historical numbers keep meaning the same thing.
  bestOddsA    Int?
  bestOddsB    Int?
  bestBookA    String?
  bestBookB    String?
  closingOddsA Int?     // last odds seen for competitorA right as the match went live —
  closingOddsB Int?     // an approximation of the "closing line," used for CLV/ROI tracking

  // Spread/totals — raw market lines from The Odds API, stored as-is.
  // NOT model-analyzed picks (matchAnalyst.js only produces moneyline
  // selections today) — this is the market's own number, shown for
  // reference. spread is signed relative to competitorA (negative =
  // competitorA favored by that many points/goals/runs).
  spread       Float?
  spreadOddsA  Int?
  spreadOddsB  Int?
  total        Float?   // over/under line
  overOdds     Int?
  underOdds    Int?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  picks        Pick[]

  @@index([sportId, startTime])
}

// ---------------------------------------------------------------------------
// Model output
// ---------------------------------------------------------------------------

model Pick {
  id           String   @id @default(uuid())
  matchId      String
  match        Match    @relation(fields: [matchId], references: [id])
  pickType     String
  market       String   @default("moneyline") // "moneyline" | "spread" | "total" | "player_points" | "player_rebounds" | "player_assists" | "player_pra" | "player_threes" | "player_blocks" | "player_steals" | "player_double_double"
  playerName   String?  // set only for player_* markets — no separate Player table yet, this is intentionally the minimal version
  line         Float?   // the spread/total number this pick was made against —
                         // captured at creation time since the market line can
                         // move before the match settles; null for moneyline
  selection    String
  confidence   Int
  odds         Int
  rationale    String
  factsUsed    String?  // JSON array of {label, tag, body} — the real facts behind this pick, for the detail page's factor breakdown
  isLive       Boolean  @default(false)
  price        Int      @default(900)
  createdAt    DateTime @default(now())

  result       Result?
  purchases    PurchasedPick[]

  @@index([matchId])
}

model Result {
  id         String   @id @default(uuid())
  pickId     String   @unique
  pick       Pick     @relation(fields: [pickId], references: [id])
  outcome    String   // "win" | "loss" | "push"
  settledAt  DateTime @default(now())
  gradedFrom String?  // "espn" | "odds_api" — which score source triggered grading
}

// Fantasy start/sit advice — deliberately its own model, not shoehorned
// into Pick. This isn't a bet with odds/a stake/a win-loss grade; it's
// real research content tied to a player's specific matchup. Admin-only
// while in development — see the on-demand endpoint in picks.js.
model StartSitAdvice {
  id         String   @id @default(uuid())
  playerName String
  team       String
  opponent   String
  sport      String   // "football" | "basketball" — the two sports fantasy advice realistically applies to
  verdict    String   // "start" | "sit"
  confidence Int
  factsUsed  String   // JSON array of {label, tag, body} — same shape Pick.factsUsed already uses
  rationale  String
  createdAt  DateTime @default(now())
}

// Real fix for a confirmed bug: results were computed successfully on
// the backend (visible in logs) but lost whenever Railway's reverse
// proxy killed the HTTP connection before a longer analysis call
// finished — the frontend saw "failed" for work that had actually
// succeeded and been paid for. Persisted here the instant it's
// computed, independent of whether the triggering request is still
// connected; the frontend fetches by matchId afterward instead of
// relying on one long-lived request/response round trip.
model PlayerPropAnalysis {
  id         String   @id @default(uuid())
  matchId    String
  playerName String
  market     String
  line       Float?
  verdict    String   // "over" | "under"
  confidence Int
  reasoning  String
  createdAt  DateTime @default(now())
}

// Curated X/Twitter accounts for the homepage's left-side Insiders
// sidebar. Only stores which handles to embed — the actual tweet
// content is rendered client-side via X's free embed widget
// (platform.twitter.com/widgets.js), so this has no ongoing API cost.
// Managed from the Health admin tab (GET/POST/DELETE /api/picks/admin/insiders).
model InsiderAccount {
  id        String   @id @default(uuid())
  sport     String   // "tennis" | "basketball" | "soccer" | "baseball" | "football"
  handle    String   // X handle, no leading @
  order     Int      @default(0)
  createdAt DateTime @default(now())

  @@unique([sport, handle])
}
