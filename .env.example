# --- Database ---
# Postgres connection string. Works with Railway, Render, Supabase, Neon, etc.
DATABASE_URL="postgresql://user:password@host:5432/matchpoint"

# --- Auth ---
# Any long random string. Generate one with: openssl rand -hex 32
JWT_SECRET="replace-with-a-real-random-secret"

# --- Stripe ---
# From https://dashboard.stripe.com/apikeys — use sk_test_... while building, sk_live_... to go live
STRIPE_SECRET_KEY="sk_test_..."
# From the Stripe webhook endpoint you create pointing at /webhooks/stripe
STRIPE_WEBHOOK_SECRET="whsec_..."
# Price IDs from https://dashboard.stripe.com/products — create one product per plan
STRIPE_PRICE_DAILY_BUNDLE="price_..."
STRIPE_PRICE_MONTHLY_MEMBERSHIP="price_..."
STRIPE_PRICE_SINGLE_PICK="price_..."

# Where Stripe Checkout redirects after payment
CHECKOUT_SUCCESS_URL="https://yourdomain.com/account.html?success=1"
CHECKOUT_CANCEL_URL="https://yourdomain.com/checkout.html?canceled=1"

# --- Sports data provider ---
# Match Point ships with a placeholder adapter (src/pipeline/fetchMatches.js).
# Plug in a real provider here — e.g. The Odds API (https://the-odds-api.com),
# SportsDataIO, or Sportradar — and fill in fetchFromProvider() with their format.
ODDS_API_KEY="your-provider-api-key-here"
ODDS_API_BASE_URL="https://api.the-odds-api.com/v4"

# --- Server ---
PORT=4000
CORS_ORIGIN="https://yourdomain.com"
