{
  "name": "match-point-backend",
  "version": "1.0.0",
  "description": "Backend for Match Point — auth, Stripe billing, and the sports data/model pipeline",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "dev": "node src/server.js",
    "start": "prisma db push --skip-generate --accept-data-loss && node src/server.js",
    "postinstall": "prisma generate",
    "pipeline": "node src/pipeline/cron.js",
    "migrate": "prisma migrate dev",
    "studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/client": "^5.19.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "node-cron": "^3.0.3",
    "node-fetch": "^2.7.0",
    "stripe": "^16.8.0"
  },
  "devDependencies": {
    "prisma": "^5.19.0"
  }
}
